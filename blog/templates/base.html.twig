<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}Welcome!
			{% endblock %}
		</title>
		<link rel="icon" href="{{ asset('images/favicon.ico') }}" type="image/x-icon">
		{% block stylesheets %}
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
			<link rel="stylesheet" href="{{ asset('css/style.css') }}">
		{% endblock %}
		{% block meta %}
			<meta name="description" content="Découvrez Bondiz, le blog dédié aux rencontres amicales. Conseils, astuces et récits pour élargir votre cercle social et créer des amitiés sincères.">
			<meta name="keywords" content="Bondiz, blog, rencontres amicales, conseils, astuces, amitiés sincères, élargir cercle social">
			<meta name="author" content="Bondiz Team">
		{% endblock %}

		{% block javascripts %}{% endblock %}
	</head>
	<body>
		<!-- Navigation -->
		<nav class="navbar">
			<div class="container nav-content">
				<a href="{{ path('app_home') }}" class="logo">
					<img src="{{ asset('images/logo.png') }}" alt="Bondiz Logo" class="header-logo">
				</a>
				<div class="nav-links">
					<a href="{{ path('app_home') }}" class="nav-link">Accueil</a>
					<a href="{{ path('app_post_index') }}" class="nav-link">Articles</a>
					<a href="{{ path('app_partner_dashboard') }}" class="nav-link{{ app.request.pathInfo starts with '/partenaires' ? ' active' }}">Partenaires</a>
					<a href="/a-propos" class="nav-link">À propos</a>
					{% if is_granted('ROLE_ADMIN') %}
						<a href="{{ path('admin') }}" class="nav-link">Administration</a>
					{% endif %}
				</div>
				{% if is_granted('ROLE_PARTNER') %}
					<div style="display: flex; align-items: center; gap: 1rem;">
						<span style="font-weight: 600;">{{ app.user.name }}</span>
						<a href="{{ path('app_partner_logout') }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Déconnexion</a>
					</div>
				{% elseif app.user %}
					<div style="display: flex; align-items: center; gap: 1rem;">
						<span style="font-weight: 600;">{{ app.user.pseudo }}</span>
						<a href="{{ path('app_logout') }}" class="btn btn-primary" style="padding: 0.5rem 1rem; font-size: 0.9rem;">Déconnexion</a>
					</div>
				{% else %}
					<a href="{{ path('app_login') }}" class="btn btn-primary">Espace Membre</a>
				{% endif %}
			</div>
		</nav>

		{% block body %}{% endblock %}

		<!-- Footer -->
		<footer class="footer">
			<div class="container">
				<div class="footer-content">
					<div class="footer-col" style="flex: 2;">
						<a href="{{ path('app_home') }}" class="logo" style="color: white; margin-bottom: 1rem; display: block;">
							Bondiz<span style="color: var(--accent-yellow);">.</span>
						</a>
						<p style="color: var(--gray); max-width: 300px;">
							Rencontre des gens près de chez toi, autour d'activités réelles. Moins d'écran, plus de vie.
						</p>
					</div>
					<div class="footer-col">
						<h3>Navigation</h3>
						<ul class="footer-links">
							<li>
								<a href="{{ path('app_home') }}">Accueil</a>
							</li>
							<li>
								<a href="{{ path('app_post_index') }}">Articles</a>
							</li>
							<li>
								<a href="/a-propos">À propos</a>
							</li>
						</ul>
					</div>
					<div class="footer-col">
						<h3>L'application</h3>
						<ul class="footer-links">
							<li>
								<a href="{{ path('app_home') }}#download">Télécharger (Android)</a>
							</li>
							<li>
								<span style="color: var(--gray); opacity: 0.5;">iOS — bientôt disponible</span>
							</li>
						</ul>
					</div>
					<div class="footer-col">
						<h3>Légal</h3>
						<ul class="footer-links">
							<li>
								<a href="{{ path('app_legal_notice') }}">Mentions légales</a>
							</li>
							<li>
								<a href="{{ path('app_privacy') }}">Confidentialité</a>
							</li>
							<li>
								<a href="{{ path('app_cookies') }}">Cookies</a>
							</li>
							<li>
								<a href="mailto:contact@bondiz.fr">Contact</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="footer-bottom">
					<p>&copy; 2026 Bondiz. Célébrons l'amitié.</p>
				</div>
			</div>
		</footer>
		<!-- ===== Tarteaucitron.js - Gestion des cookies RGPD ===== -->
		<script src="https://cdn.jsdelivr.net/npm/tarteaucitronjs@1.20.1/tarteaucitron.js"></script>
		<script>
			tarteaucitron.init({
				"privacyUrl": "{{ path('app_privacy') }}",
				"hashtag": "#tarteaucitron",
				"cookieName": "bondiz_tarteaucitron",
				"orientation": "bottom",
				"groupServices": false,
				"showAlertSmall": false,
				"cookieslist": true,
				"closePopup": false,
				"showIcon": false,
				"iconPosition": "BottomRight",
				"adblocker": false,
				"DenyAllCta": true,
				"AcceptAllCta": true,
				"highPrivacy": true,
				"handleBrowserDNTRequest": false,
				"removeCredit": false,
				"moreInfoLink": true,
				"useExternalCss": false,
				"useExternalJs": false,
				"mandatory": true,
				"mandatoryCta": true
			});

			/* Google Analytics 4 — chargé uniquement après consentement */
			tarteaucitron.user.gtagUa = 'G-K3MZFD8TGX';
			(tarteaucitron.job = tarteaucitron.job || []).push('gtag');
		</script>
		<!-- ===== Fin Tarteaucitron ===== -->
	</body>
</html>
