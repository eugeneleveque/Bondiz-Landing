{% extends 'partner/_espace.html.twig' %}

{% block title %}Modifier ma fiche - Espace partenaire Bondiz{% endblock %}

{% form_theme form 'partner/_form_theme.html.twig' %}

{% block contenu %}
	<div class="bz-espace__titre">
		<a href="{{ path('app_partner_establishment') }}" class="bz-espace__retour">← Mon établissement</a>
		<h1>Modifier ma fiche</h1>
		<p>Pour changer le nom, la catégorie ou l’e-mail de connexion, écrivez-nous depuis la <a href="{{ path('app_partner_messages') }}">messagerie</a>.</p>
	</div>

	<div class="bz-formulaire-activite">
		{{ form_start(form, {attr: {class: 'bz-panneau partner-card', novalidate: 'novalidate'}}) }}
			{% if form.vars.errors|length %}
				<div class="bz-alerte bz-alerte--erreur" role="alert">
					{% for error in form.vars.errors %}{{ error.message }}{% endfor %}
				</div>
			{% endif %}

			{{ form_row(form.address) }}
			<div class="partner-grid">
				{{ form_row(form.postalCode) }}
				{{ form_row(form.city) }}
			</div>
			<div class="partner-grid">
				{{ form_row(form.phone) }}
				{{ form_row(form.website) }}
			</div>
			{{ form_row(form.description) }}

			<fieldset class="bz-saisie-horaires" id="horaires">
				<legend>Horaires d’ouverture</legend>
				<div class="partner-grid">
					{% for cle, jour in jours %}
						{{ form_row(attribute(form, cle)) }}
					{% endfor %}
				</div>
			</fieldset>

			<div class="partner-form-actions">
				<a href="{{ path('app_partner_establishment') }}" class="bz-lien-action">Annuler</a>
				<button type="submit" class="bz-bouton-violet">Enregistrer</button>
			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
