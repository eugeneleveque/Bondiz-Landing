{% extends 'partner/_espace.html.twig' %}

{% block title %}{{ activity ? 'Modifier l’activité' : 'Nouvelle activité' }} - Espace partenaires Bondiz{% endblock %}

{% form_theme form 'partner/_form_theme.html.twig' %}

{% block contenu %}
	<div class="bz-espace__titre">
		<a href="{{ path('app_partner_activities') }}" class="bz-espace__retour">← Mes activités</a>
		<h1>{{ activity ? 'Modifier l’activité' : 'Nouvelle activité' }}</h1>
		{% if activity and activity.bookingsCount > 0 %}
			<p>{{ activity.bookingsCount }} réservation{{ activity.bookingsCount > 1 ? 's' }} : prévenez les participants si vous changez la date ou le lieu.</p>
		{% endif %}
	</div>

	<div class="bz-formulaire-activite">
		{{ form_start(form, {attr: {class: 'bz-panneau partner-card', novalidate: 'novalidate'}}) }}
			{% if form.vars.errors|length %}
				<div class="bz-alerte bz-alerte--erreur" role="alert">
					{% for error in form.vars.errors %}{{ error.message }}{% endfor %}
				</div>
			{% endif %}

			{{ form_row(form.title) }}
			{{ form_row(form.description) }}
			{{ form_row(form.location) }}

			<div class="partner-grid">
				{{ form_row(form.startDate) }}
				{{ form_row(form.endDate) }}
			</div>

			<div class="partner-grid">
				{{ form_row(form.minParticipants) }}
				{{ form_row(form.maxParticipants) }}
			</div>

			{{ form_row(form.price) }}

			<div class="partner-form-actions">
				<a href="{{ path('app_partner_activities') }}" class="bz-lien-action">Annuler</a>
				<button type="submit" class="bz-bouton-violet">{{ activity ? 'Enregistrer' : 'Publier l’activité' }}</button>
			</div>
		{{ form_end(form) }}
	</div>
{% endblock %}
