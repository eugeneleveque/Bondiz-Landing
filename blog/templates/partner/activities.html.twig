{% extends 'partner/_espace.html.twig' %}

{% block title %}Mes activités - Espace partenaire Bondiz{% endblock %}

{% macro activite(activity, past = false) %}
	{% set tz = 'Europe/Paris' %}
	<article class="bz-panneau bz-activite-partenaire{{ past ? ' bz-activite-partenaire--passee' }}">
		<div class="bz-activite-partenaire__texte">
			<h3 class="bz-panneau__titre">{{ activity.title }}</h3>
			<ul class="bz-activite-partenaire__infos">
				<li>
					<span>Quand</span>
					{% if activity.startDate %}
						{{ activity.startDate|date('d/m/Y \\à H\\hi', tz) }}
						{% if activity.endDate %}
							→ {{ activity.endDate|date(activity.endDate|date('Ymd', tz) == activity.startDate|date('Ymd', tz) ? 'H\\hi' : 'd/m/Y \\à H\\hi', tz) }}
						{% endif %}
					{% else %}
						Date libre
					{% endif %}
				</li>
				{% if activity.location %}
					<li><span>Où</span> {{ activity.location }}</li>
				{% endif %}
				<li>
					<span>Prix</span>
					{{ activity.price is not null ? (activity.price == 0 ? 'Gratuit' : activity.price|number_format(2, ',', ' ') ~ ' €') : 'Non renseigné' }}
				</li>
				{% if activity.minParticipants or activity.maxParticipants %}
					<li>
						<span>Groupe</span>
						{% if activity.minParticipants and activity.maxParticipants %}
							{{ activity.minParticipants }} à {{ activity.maxParticipants }} personnes
						{% elseif activity.maxParticipants %}
							jusqu’à {{ activity.maxParticipants }} personnes
						{% else %}
							{{ activity.minParticipants }} personnes minimum
						{% endif %}
					</li>
				{% endif %}
			</ul>
		</div>
		<div class="bz-activite-partenaire__actions">
			<span class="bz-prochaine__reservations">{{ activity.bookingsCount }} réservation{{ activity.bookingsCount > 1 ? 's' }}</span>
			<a href="{{ path('app_partner_activity_edit', {id: activity.documentId}) }}" class="bz-lien-action">Modifier</a>
			{% if activity.bookingsCount == 0 %}
				<form method="post" action="{{ path('app_partner_activity_delete', {id: activity.documentId}) }}" onsubmit="return confirm('Supprimer définitivement « {{ activity.title|e('js') }} » ?');">
					<input type="hidden" name="_token" value="{{ csrf_token('delete-activity-' ~ activity.documentId) }}">
					<button type="submit" class="bz-lien-action bz-lien-action--danger">Supprimer</button>
				</form>
			{% endif %}
		</div>
	</article>
{% endmacro %}

{% block contenu %}
	<div class="bz-espace__titre bz-espace__titre--actions">
		<div>
			<h1>Mes activités</h1>
			<p>Les activités publiées ici apparaissent dans l’application Bondiz, où les utilisateurs peuvent les réserver.</p>
		</div>
		<a href="{{ path('app_partner_activity_new') }}" class="bz-bouton bz-bouton--jaune">+ Nouvelle activité</a>
	</div>

	<section class="bz-activites-partenaire">
		<h2 class="bz-activites-partenaire__titre">À venir <span>{{ upcoming|length }}</span></h2>
		{% for activity in upcoming %}
			{{ _self.activite(activity) }}
		{% else %}
			<div class="bz-panneau bz-prochaines__vide">
				<p>Aucune activité à venir.</p>
				<a href="{{ path('app_partner_activity_new') }}" class="bz-bouton-violet">Proposer ma première activité</a>
			</div>
		{% endfor %}
	</section>

	{% if past is not empty %}
		<section class="bz-activites-partenaire">
			<h2 class="bz-activites-partenaire__titre">Passées <span>{{ past|length }}</span></h2>
			{% for activity in past %}
				{{ _self.activite(activity, true) }}
			{% endfor %}
		</section>
	{% endif %}
{% endblock %}
