{% extends 'partner/_espace.html.twig' %}

{% block title %}Mes messages - Espace partenaire Bondiz{% endblock %}

{# Un seul fil par partenaire : ses échanges avec l'équipe Bondiz. #}
{% block contenu %}
	{% set fantome = asset('images/brand/logo-fantome.svg') %}

	<div class="bz-espace__titre">
		<h1>Mes messages</h1>
		<p>Retrouvez ici tous vos échanges avec l’équipe Bondiz</p>
	</div>

	<section class="bz-panneau bz-discussion bz-discussion--seule" aria-label="Conversation avec l’équipe Bondiz">
		<header class="bz-discussion__haut">
			<span class="bz-avatar bz-avatar--grand bz-avatar--bondiz" aria-hidden="true"><img src="{{ fantome }}" alt=""></span>
			<div>
				<h2 class="bz-discussion__nom">Équipe Bondiz</h2>
				<p class="bz-discussion__statut">Support partenaires</p>
			</div>
		</header>

		<ol class="bz-discussion__fil">
			<li class="bz-message">
				<span class="bz-avatar bz-avatar--bondiz" aria-hidden="true"><img src="{{ fantome }}" alt=""></span>
				<div>
					<p class="bz-message__bulle">
						Bonjour {{ app.user.name }}&nbsp;!<br>
						Une question sur vos activités, vos réservations ou votre fiche&nbsp;? Écrivez-nous ici.
					</p>
				</div>
			</li>
			{% for message in messages %}
				<li class="bz-message{{ message.fromTeam ? '' : ' bz-message--moi' }}">
					{% if message.fromTeam %}
						<span class="bz-avatar bz-avatar--bondiz" aria-hidden="true"><img src="{{ fantome }}" alt=""></span>
					{% endif %}
					<div>
						<p class="bz-message__date">
							{{ message.fromTeam ? 'Équipe Bondiz' : 'Vous' }} ·
							<time datetime="{{ message.createdAt }}">{{ message.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}</time>
						</p>
						<p class="bz-message__bulle">{{ message.content|nl2br }}</p>
					</div>
				</li>
			{% endfor %}
		</ol>

		<form method="post" action="{{ path('app_partner_messages') }}" class="bz-discussion__saisie">
			<input type="hidden" name="_token" value="{{ csrf_token('partner-message') }}">
			<div class="bz-discussion__champ">
				<label class="bz-visuellement-cache" for="message">Écrire un message</label>
				<textarea id="message" name="message" rows="2" maxlength="2000" required placeholder="Écrire un message...">{{ brouillon }}</textarea>
				<button type="submit" class="bz-discussion__envoyer" aria-label="Envoyer">
					<img src="{{ asset('images/espace-partenaire/envoyer.png') }}" alt="">
				</button>
			</div>
		</form>
	</section>
{% endblock %}
