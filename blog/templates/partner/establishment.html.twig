{% extends 'partner/_espace.html.twig' %}

{% import 'partner/_macros.html.twig' as espace %}

{% block title %}Mon établissement - Espace partenaire Bondiz{% endblock %}

{#
	Le partenaire modifie lui-même ses coordonnées, ses horaires, sa description
	et ses photos. Le nom et la catégorie restent gérés par l'équipe Bondiz.
#}
{% block contenu %}
	{% set partenaire = app.user %}
	{% set categories = {
		restaurant: 'Restaurant', bar: 'Bar', cafe: 'Café', bowling: 'Bowling',
		escape_game: 'Escape game', cinema: 'Cinéma', museum: 'Musée', sport: 'Sport',
		karaoke: 'Karaoké', concert_venue: 'Salle de concert', other: 'Autre'
	} %}
	{% set statuts = {
		active: { libelle: 'Publié', classe: 'verte' },
		pending: { libelle: 'En attente de validation', classe: 'grise' },
	} %}
	{% set statut = statuts[partenaire.state] ?? null %}
	{% set modifier = path('app_partner_establishment_edit') %}
	{% set a_completer %}<span class="bz-a-completer">À compléter</span>{% endset %}

	<div class="bz-espace__titre">
		<h1>Mon établissement</h1>
		<p>Retrouvez et modifiez toutes les informations concernant votre établissement.</p>
	</div>

	<section class="bz-panneau bz-fiche">
		{% set couverture = photos|first %}
		<div class="bz-fiche__photo{{ couverture and couverture.url ? ' bz-fiche__photo--image' }}" aria-hidden="true">
			<img src="{{ couverture and couverture.url ? couverture.url : asset('images/brand/logo-fantome.svg') }}" alt="">
		</div>

		<div class="bz-fiche__infos">
			<div class="bz-fiche__nom">
				<h2>{{ partenaire.name }}</h2>
				{% if statut %}
					<span class="bz-pastille bz-pastille--{{ statut.classe }}">{{ statut.libelle }}</span>
				{% endif %}
			</div>
			<ul class="bz-fiche__details">
				<li>
					<img src="{{ asset('images/espace-partenaire/localisation.png') }}" alt="Adresse">
					{% set adresse = [fiche.address|default(''), (fiche.postalCode|default('') ~ ' ' ~ fiche.city|default(''))|trim]|filter(v => v)|join(', ') %}
					{{ adresse ?: a_completer }}
				</li>
				<li>
					<img src="{{ asset('images/espace-partenaire/etiquette.png') }}" alt="Catégorie">
					{{ categories[partenaire.category] ?? a_completer }}
				</li>
				{% if fiche.phone|default %}<li class="bz-fiche__contact">{{ fiche.phone matches '/^\\d{10}$/' ? fiche.phone|split('', 2)|join(' ') : fiche.phone }}</li>{% endif %}
				{% if fiche.website|default and fiche.website matches '#^https?://#i' %}
					<li class="bz-fiche__contact"><a href="{{ fiche.website }}" target="_blank" rel="noopener noreferrer">{{ fiche.website }}</a></li>
				{% endif %}
			</ul>
			<a href="{{ modifier }}" class="bz-bouton-contour bz-bouton-contour--grand">
				<img src="{{ asset('images/espace-partenaire/crayon.png') }}" alt="">
				Modifier mes informations
			</a>
		</div>

		<ul class="bz-fiche__chiffres">
			<li>
				<img src="{{ asset('images/espace-partenaire/calendrier-violet.png') }}" alt="">
				<p><strong>{{ tableau.totaux.activites }}</strong> activité{{ tableau.totaux.activites > 1 ? 's' }} organisée{{ tableau.totaux.activites > 1 ? 's' }}</p>
			</li>
			<li>
				<img src="{{ asset('images/espace-partenaire/personnes-violet.png') }}" alt="">
				<p><strong>{{ tableau.totaux.participants }}</strong> participant{{ tableau.totaux.participants > 1 ? 's' }} au total</p>
			</li>
			<li>
				<img src="{{ asset('images/espace-partenaire/etoile-violet.png') }}" alt="">
				{# Les avis des participants ne sont pas encore recueillis. #}
				<p><strong>–</strong> satisfaction moyenne</p>
			</li>
		</ul>
	</section>

	<div class="bz-etablissement">
		<section class="bz-panneau bz-bloc-fiche">
			<div class="bz-panneau__entete">
				<h2 class="bz-bloc-fiche__titre">
					<span class="bz-indicateur__rond bz-rond--violet" aria-hidden="true"><img src="{{ asset('images/espace-partenaire/image.png') }}" alt=""></span>
					Photos de votre établissement
				</h2>
			</div>

			{% if photos %}
				<ul class="bz-photos">
					{% for photo in photos %}
						<li class="bz-photo">
							{% if photo.url %}
								<img src="{{ photo.url }}" alt="Photo {{ loop.index }}" loading="lazy">
							{% else %}
								<span class="bz-a-completer">Aperçu indisponible</span>
							{% endif %}
							<form method="post" action="{{ path('app_partner_photo_delete', {id: photo.id}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('delete-photo-' ~ photo.id) }}">
								<button type="submit" class="bz-photo__supprimer" aria-label="Supprimer la photo {{ loop.index }}">×</button>
							</form>
						</li>
					{% endfor %}
				</ul>
				<p class="bz-photos__note">La première photo illustre votre établissement sur le site.</p>
			{% endif %}

			{% if photos|length < 8 %}
				{{ form_start(formulairePhoto, {attr: {class: 'bz-envoi-photo'}}) }}
					{{ form_label(formulairePhoto.photo) }}
					{{ form_widget(formulairePhoto.photo) }}
					<button type="submit" class="bz-bouton-violet">Envoyer</button>
				{{ form_end(formulairePhoto) }}
			{% else %}
				<p class="bz-photos__note">Vous avez atteint la limite de 8 photos.</p>
			{% endif %}
		</section>

		<section class="bz-panneau bz-bloc-fiche">
			<div class="bz-panneau__entete">
				<h2 class="bz-bloc-fiche__titre">
					<span class="bz-indicateur__rond bz-rond--rose" aria-hidden="true"><img src="{{ asset('images/espace-partenaire/horloge.png') }}" alt=""></span>
					Horaires d’ouverture
				</h2>
				<a href="{{ modifier }}#horaires" class="bz-prochaines__tous">Modifier</a>
			</div>
			<table class="bz-horaires">
				<caption class="bz-visuellement-cache">Horaires d’ouverture</caption>
				<tbody>
					{% for cle, jour in jours %}
						<tr>
							<th scope="row">{{ jour }}</th>
							<td>{{ fiche.openingHours[cle]|default ?: a_completer }}</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>
		</section>

		<section class="bz-panneau bz-bloc-fiche">
			<div class="bz-panneau__entete">
				<h2 class="bz-bloc-fiche__titre">
					<span class="bz-indicateur__rond bz-rond--jaune" aria-hidden="true"><img src="{{ asset('images/espace-partenaire/document.png') }}" alt=""></span>
					Description détaillée
				</h2>
				<a href="{{ modifier }}" class="bz-prochaines__tous">Modifier</a>
			</div>
			{% if fiche.description|default %}
				<p class="bz-bloc-fiche__texte">{{ fiche.description|nl2br }}</p>
			{% else %}
				<p class="bz-bloc-fiche__texte bz-a-completer">Présentez votre établissement aux utilisateurs de Bondiz : ce qu’on y fait, l’ambiance, ce qui le rend unique.</p>
			{% endif %}
		</section>

		{{ espace.aide() }}
	</div>
{% endblock %}
