{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}Partenaires{% endblock %}
{% block content_title %}Partenaires{% endblock %}

{% block page_actions %}
	<a href="{{ path('admin_partners_new') }}" class="btn btn-primary">Créer un partenaire</a>
{% endblock %}

{% block main %}
	{% if identifiants %}
		{% if identifiants.password %}
			<div class="alert alert-warning" role="alert">
				<p><strong>{{ identifiants.name }}</strong> est créé, mais <strong>l’e-mail n’a pas pu être envoyé</strong>. Transmettez ces identifiants vous-même : ils ne seront plus affichés.</p>
				<p>E-mail : <code>{{ identifiants.email }}</code><br>Mot de passe : <code>{{ identifiants.password }}</code></p>
				<p>Adresse de connexion : <code>{{ url('app_partner_login') }}</code></p>
			</div>
		{% else %}
			<div class="alert alert-success" role="status">
				<strong>{{ identifiants.name }}</strong> est créé. Ses identifiants ont été envoyés à {{ identifiants.email }}.
			</div>
		{% endif %}
	{% endif %}

	{% if erreur %}
		<div class="alert alert-danger" role="alert">{{ erreur }}</div>
	{% else %}
		<div class="table-responsive">
			<table class="table datagrid">
				<thead>
					<tr><th>Établissement</th><th>E-mail</th><th>Ville</th><th>État</th><th>Action</th></tr>
				</thead>
				<tbody>
					{% for partenaire in partenaires %}
						<tr>
							<td>{{ partenaire.name }}</td>
							<td>{{ partenaire.email }}</td>
							<td>{{ partenaire.city }}</td>
							<td>{{ etats[partenaire.states]|default('—') }}</td>
							<td class="bz-actions-partenaire">
								<a href="{{ path('admin_partner_thread', {documentId: partenaire.documentId}) }}" class="btn btn-secondary btn-sm">Écrire</a>
								<form method="post" action="{{ path('admin_partners_state', {documentId: partenaire.documentId}) }}">
									<input type="hidden" name="_token" value="{{ csrf_token('partenaire-etat') }}">
									{% if partenaire.states == 'active' %}
										<button name="etat" value="suspended" class="btn btn-secondary btn-sm">Suspendre</button>
									{% else %}
										<button name="etat" value="active" class="btn btn-primary btn-sm">Activer</button>
									{% endif %}
								</form>
							</td>
						</tr>
					{% else %}
						<tr><td colspan="5">Aucun partenaire pour le moment.</td></tr>
					{% endfor %}
				</tbody>
			</table>
		</div>
		<p class="text-muted">Suspendre bloque la connexion du partenaire. Chaque partenaire complète sa fiche et ses photos depuis son espace ; le logo et le nom se modifient dans Strapi.</p>
	{% endif %}
{% endblock %}
