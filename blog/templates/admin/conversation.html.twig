{% extends '@EasyAdmin/page/content.html.twig' %}

{% block page_title %}{{ partenaire.name }}{% endblock %}
{% block content_title %}{{ partenaire.name }}{% endblock %}

{% block page_actions %}
	<a href="{{ path('admin_partner_messages') }}" class="btn btn-secondary">Toutes les conversations</a>
{% endblock %}

{% block main %}
	<div class="bz-fil">
		<p class="text-muted">{{ partenaire.email }}</p>
		<ol class="bz-fil__messages">
			{% for message in messages %}
				<li class="bz-fil__message{{ message.fromTeam ? ' bz-fil__message--equipe' }}">
					<small>{{ message.fromTeam ? 'Équipe Bondiz' : partenaire.name }} · {{ message.createdAt|date('d/m/Y à H:i', 'Europe/Paris') }}</small>
					<p>{{ message.content|nl2br }}</p>
				</li>
			{% else %}
				<li class="text-muted">Aucun message pour l’instant.</li>
			{% endfor %}
		</ol>

		<form method="post" action="{{ path('admin_partner_thread', {documentId: partenaire.documentId}) }}">
			<input type="hidden" name="_token" value="{{ csrf_token('partenaire-message') }}">
			<label for="message" class="form-control-label">Votre réponse</label>
			<textarea id="message" name="message" class="form-control" rows="4" maxlength="2000" required>{{ brouillon }}</textarea>
			<button type="submit" class="btn btn-primary mt-3">Envoyer</button>
		</form>
		<p class="text-muted mt-3">Le partenaire verra votre réponse dans son espace ; il ne reçoit pas d’e-mail.</p>
	</div>
{% endblock %}
