{% extends 'base.html.twig' %}

{% block title %}Bondiz - L'application de rencontres amicales à Angers{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block page_class %}bz-page--accueil{% endblock %}

{# Dégradé de la maquette : quatre tranches, une sur deux retournée. #}
{% block page_fond %}
	<div class="bz-fond" aria-hidden="true">
		<div class="bz-fond__tranche"></div>
		<div class="bz-fond__tranche bz-fond__tranche--retournee"></div>
		<div class="bz-fond__tranche"></div>
		<div class="bz-fond__tranche bz-fond__tranche--retournee bz-fond__tranche--fin"></div>
	</div>
{% endblock %}

{% block body %}
	<main class="bz-principal">

		<section class="bz-heros">
			<div class="bz-conteneur bz-heros__contenu">
				<div class="bz-heros__texte">
					<h1 class="bz-heros__accroche">
						<span class="bz-heros__accroche-ligne">MOINS DE GHOSTING.</span>
						<span class="bz-heros__accroche-ligne bz-heros__accroche-ligne--forte">PLUS DE RENCONTRES</span>
					</h1>
					<p class="bz-heros__intro">
						Envie de faire de nouvelles rencontres, mais tu ne sais pas par où commencer ? Avec Bondiz, découvre des personnes qui partagent tes centres d’intérêt et retrouve-les autour d’activités disponibles à Angers grâce à nos lieux partenaires. Que tu préfères être mis en relation grâce à tes passions ou rejoindre directement une activité, il ne te reste plus qu’à te lancer et à faire de nouvelles rencontres !
					</p>
					<div class="bz-actions">
						<a href="/downloads/bondiz.apk" download class="bz-bouton bz-bouton--jaune">Télécharger l’application</a>
						<a href="{{ path('app_devenir_partenaire') }}" class="bz-bouton bz-bouton--rose">Devenir partenaire</a>
					</div>
				</div>
				<div class="bz-heros__visuel">
					<img src="{{ asset('images/home/telephone-accueil.png') }}" alt="L’application Bondiz : profil d’une personne avec ses centres d’intérêt" width="412" height="582">
				</div>
			</div>

			<div class="bz-conteneur">
				<article class="bz-carte bz-carte--intro">
					<div class="bz-carte__texte">
						<h2 class="bz-titre">Rencontrer de nouvelles personnes, autrement</h2>
						<p class="bz-texte">
							Tu as envie d'élargir ton cercle social, de découvrir de nouvelles activités ou simplement de sortir de ta routine ? Bondiz t'aide à créer des occasions de rencontres amicales dans la vraie vie, en partageant des expériences avec des personnes qui ont des centres d'intérêt communs.
						</p>
					</div>
					<div class="bz-carte__image">
						<img src="{{ asset('images/home/photo-amis.png') }}" alt="Un groupe d’amis souriants, photographié en contre-plongée" loading="lazy">
					</div>
				</article>
			</div>
		</section>

		<section id="comment-ca-marche" class="bz-bande bz-fonctionnement">
			<div class="bz-conteneur">
				<h2 class="bz-titre">Comment fonctionne Bondiz ?</h2>
				<div class="bz-tuiles">
					<article class="bz-tuile bz-tuile--jaune">
						<div class="bz-tuile__pastille">
							<img src="{{ asset('images/home/icone-passions.png') }}" alt="" class="bz-tuile__icone">
						</div>
						<h3 class="bz-sous-titre">Rencontre des personnes qui partagent tes passions</h3>
						<p class="bz-texte">Renseigne tes centres d'intérêt pour découvrir des personnes avec qui tu pourrais avoir des affinités, puis trouver une activité à partager.</p>
					</article>
					<article class="bz-tuile bz-tuile--rose">
						<div class="bz-tuile__pastille">
							<img src="{{ asset('images/home/icone-activite.png') }}" alt="" class="bz-tuile__icone">
						</div>
						<h3 class="bz-sous-titre">Ou rejoins directement une activité en fonction de tes intérêts !</h3>
						<p class="bz-texte">Tu as repéré une sortie qui te plaît ? Inscris-toi pour y participer, sans avoir besoin de te connecter avec une autre personne au préalable.</p>
					</article>
				</div>
			</div>
		</section>

		<section id="activites" class="bz-conteneur bz-activites">
			<article class="bz-carte bz-carte--activites">
				<div class="bz-carte__texte">
					<h2 class="bz-titre">Quelles activités faire à Angers ?</h2>
					<p class="bz-texte">
						Une soirée jeux de société, un atelier poterie, un café-lecture, une séance de basket ou une activité culinaire… Découvre de nouvelles expériences à partager et profite de ta ville autrement.
					</p>
					<a href="https://app.bondiz.fr" class="bz-bouton bz-bouton--rose">Découvrir toutes les activités Bondiz</a>
				</div>
				<div class="bz-carte__image">
					<img src="{{ asset('images/home/photo-basket.png') }}" alt="Des jeunes jouent au basket sur un terrain en plein air" loading="lazy">
				</div>
			</article>
		</section>

		<section id="partenaires" class="bz-partenaires">
			<img src="{{ asset('images/home/telephone-activites.png') }}" alt="La liste des activités dans l’application Bondiz" class="bz-partenaires__telephone" width="911" height="644" loading="lazy">
			<div class="bz-conteneur">
				<div class="bz-partenaires__carte">
					<h2 class="bz-titre">Vous êtes un professionnel à Angers ?<br>Créons des rencontres ensemble.</h2>
					<p class="bz-texte">
						Vous gérez un café, un bar, un atelier créatif ou un lieu de loisirs ? Bondiz souhaite collaborer avec les acteurs locaux pour proposer des activités collectives et favoriser les rencontres.
					</p>
					<a href="{{ path('app_devenir_partenaire') }}" class="bz-bouton bz-bouton--jaune">Devenir partenaire</a>
				</div>
			</div>
		</section>

		<section id="telecharger" class="bz-bande bz-appel">
			<div class="bz-conteneur">
				<h2 class="bz-titre">Et si ta prochaine rencontre commençait ici ?</h2>
				<p class="bz-texte">Découvre Bondiz et trouve de nouvelles occasions de rencontrer des personnes à Angers.</p>
				<a href="/downloads/bondiz.apk" download class="bz-bouton bz-bouton--rose">Télécharger l’application</a>
			</div>
		</section>

	</main>
{% endblock %}
