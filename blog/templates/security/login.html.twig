{% extends 'base.html.twig' %}

{% block title %}{{ 'login.title'|trans({}, 'messages') }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link rel="stylesheet" href="{{ asset('css/connexion.css') }}">
{% endblock %}

{% block body %}
	<main class="bz-principal bz-connexion">
		<form method="post" class="bz-connexion__carte">
			<h1 class="bz-titre">{{ 'login.header'|trans({}, 'messages') }}</h1>

			{% if error %}
				<p class="bz-connexion__erreur" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
			{% endif %}

			<label class="bz-connexion__champ">
				{{ 'form.email'|trans({}, 'messages') }}
				<input type="email" name="_username" id="username" value="{{ last_username }}" autocomplete="email" required autofocus>
			</label>

			<label class="bz-connexion__champ">
				{{ 'form.password'|trans({}, 'messages') }}
				<input type="password" name="_password" id="password" autocomplete="current-password" required>
			</label>

			<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

			<button type="submit" class="bz-bouton bz-bouton--jaune">{{ 'login.submit'|trans({}, 'messages') }}</button>
		</form>
	</main>
{% endblock %}
